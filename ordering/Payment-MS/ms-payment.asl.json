{
    "Comment": "Microservicio Pagos - SAGA Participant (Producción)",
    "QueryLanguage": "JSONata",
    "StartAt": "Preparar Contexto",
    "States": {
        "Preparar Contexto": {
            "Type": "Pass",
            "Assign": {
                "inputData": "{% $states.input.detail.data %}",
                "meta": "{% $states.input.detail.meta %}",
                "tokenOrquestador": "{% $states.input.detail.data.myTaskToken %}",
                "busName": "${self:custom.EventBusName}",
                "txTable": "${self:custom.TransactionsTableName}",
                "eventType": "{% $states.input.'detail-type' %}"
            },
            "Next": "Router Eventos"
        },
        "Router Eventos": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% $eventType = 'Payment.Initiate' %}",
                    "Next": "Validar Datos de Entrada"
                },
                {
                    "Condition": "{% $eventType = 'Pedido.Cancelado' %}",
                    "Next": "Procesar Reembolso"
                }
            ],
            "Default": "Evento Desconocido"
        },
        "Evento Desconocido": {
            "Type": "Fail",
            "Error": "UnknownEvent",
            "Cause": "El tipo de evento no es soportado"
        },
        "Validar Datos de Entrada": {
            "Type": "Pass",
            "Comment": "Validación estructural básica antes de invocar lambdas",
            "Next": "Tiene RUC?"
        },
        "Tiene RUC?": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% $exists($inputData.ruc) %}",
                    "Next": "Validar RUC (Sunat/Api)"
                }
            ],
            "Default": "Analisis de Riesgo (Anti-Fraude)"
        },
        "Validar RUC (Sunat/Api)": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Comment": "Consulta API externa (ej. Sunat/Padron) para ver estado del contribuyente",
            "Arguments": {
                "FunctionName": "${ValidateRucFunctionArn}",
                "Payload": {
                    "ruc": "{% $inputData.ruc %}"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "MaxAttempts": 2,
                    "BackoffRate": 1.5
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "SAGA: Reportar Fallo (RUC)"
                }
            ],
            "Assign": {
                "rucValido": "{% $states.result.Payload.valido %}"
            },
            "Next": "Verificar RUC Valido"
        },
        "Verificar RUC Valido": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% $rucValido = true %}",
                    "Next": "Analisis de Riesgo (Anti-Fraude)"
                }
            ],
            "Default": "SAGA: Reportar Fallo (RUC)"
        },
        "Analisis de Riesgo (Anti-Fraude)": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Comment": "Evalúa riesgo basado en monto, usuario y comportamiento",
            "Arguments": {
                "FunctionName": "${FraudDetectionFunctionArn}",
                "Payload": {
                    "userId": "{% $meta.userId %}",
                    "amount": "{% $inputData.amount %}",
                    "userIp": "{% $meta.ipAddress %}",
                    "deviceId": "{% $meta.deviceId %}",
                    "email": "{% $meta.email %}"
                }
            },
            "Assign": {
                "riskScore": "{% $states.result.Payload.score %}",
                "riskReason": "{% $states.result.Payload.reason %}"
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "MaxAttempts": 2
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Comment": "Si falla el detector, asumimos riesgo alto por seguridad o continuamos con warning",
                    "Next": "SAGA: Reportar Fallo (Tecnico)"
                }
            ],
            "Next": "Evaluacion de Riesgo"
        },
        "Evaluacion de Riesgo": {
            "Type": "Choice",
            "Comment": "Score 0-100. >80 es bloqueo inmediato.",
            "Choices": [
                {
                    "Condition": "{% $riskScore > 80 %}",
                    "Next": "SAGA: Reportar Fallo (Fraude)"
                }
            ],
            "Default": "Ejecutar Pasarela de Pago"
        },
        "Ejecutar Pasarela de Pago": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Comment": "Invoca a la Lambda que conecta con Stripe/Visa/Niubiz",
            "Arguments": {
                "FunctionName": "${ProcessPaymentFunctionArn}",
                "Payload": {
                    "amount": "{% $inputData.amount %}",
                    "token": "{% $inputData.paymentToken %}",
                    "orderId": "{% $inputData.orderId %}",
                    "email": "{% $meta.email %}"
                }
            },
            "Assign": {
                "paymentResult": "{% $states.result.Payload %}"
            },
            "Catch": [
                {
                    "ErrorEquals": [
                        "PaymentRejected",
                        "InsufficientFunds",
                        "CardExpired"
                    ],
                    "Next": "SAGA: Reportar Fallo (Banco)"
                },
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "SAGA: Reportar Fallo (Tecnico)"
                }
            ],
            "Next": "Registrar Transaccion Exitosa"
        },
        "Registrar Transaccion Exitosa": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
                "TableName": "{% $txTable %}",
                "Item": {
                    "pk": {
                        "S": "{% 'TX#' & $uuid() %}"
                    },
                    "sk": {
                        "S": "METADATA"
                    },
                    "orderId": {
                        "S": "{% $inputData.orderId %}"
                    },
                    "userId": {
                        "S": "{% $meta.userId %}"
                    },
                    "amount": {
                        "N": "{% $string($inputData.amount) %}"
                    },
                    "status": {
                        "S": "COMPLETED"
                    },
                    "gatewayId": {
                        "S": "{% $paymentResult.transactionId %}"
                    },
                    "timestamp": {
                        "S": "{% $now() %}"
                    },
                    "invoiceType": {
                        "S": "{% $exists($inputData.ruc) ? 'FACTURA' : 'BOLETA' %}"
                    },
                    "riskScore": {
                        "N": "{% $string($riskScore) %}"
                    }
                }
            },
            "Next": "SAGA: Confirmar al Orquestador"
        },
        "SAGA: Confirmar al Orquestador": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskSuccess",
            "Comment": "AVISA A ORDER-MS QUE EL PAGO PASO. ESTO DESBLOQUEA EL PEDIDO.",
            "Arguments": {
                "TaskToken": "{% $tokenOrquestador %}",
                "Output": "{% $string({ 'status': 'PAID', 'txId': $paymentResult.transactionId }) %}"
            },
            "Next": "Paralelo: Notificar y Facturar"
        },
        "Paralelo: Notificar y Facturar": {
            "Type": "Parallel",
            "Branches": [
                {
                    "StartAt": "Notificar: Pago Exitoso",
                    "States": {
                        "Notificar: Pago Exitoso": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::events:putEvents",
                            "Arguments": {
                                "Entries": [
                                    {
                                        "Source": "app.payments",
                                        "DetailType": "Payment.Success",
                                        "EventBusName": "{% $busName %}",
                                        "Detail": "{% $string({ \"meta\": $merge([$meta, { \"scope\": \"NOTIFICATION\", \"targetType\": \"USER\", \"targetId\": $meta.userId }]), \"ui\": { \"action\": \"SHOW_TOAST\", \"variant\": \"SUCCESS\", \"message\": \"Pago procesado correctamente\" }, \"data\": { \"orderId\": $inputData.orderId, \"txId\": $paymentResult.transactionId } }) %}"
                                    }
                                ]
                            },
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "Verificar Facturacion",
                    "States": {
                        "Verificar Facturacion": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Condition": "{% $exists($inputData.ruc) %}",
                                    "Next": "Emitir Comprobante"
                                }
                            ],
                            "Default": "No Requiere Factura"
                        },
                        "No Requiere Factura": {
                            "Type": "Pass",
                            "End": true
                        },
                        "Emitir Comprobante": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::events:putEvents",
                            "Comment": "Emite evento para que el modulo de facturacion electronica lo tome",
                            "Arguments": {
                                "Entries": [
                                    {
                                        "Source": "app.payments",
                                        "DetailType": "Billing.GenerateInvoice",
                                        "EventBusName": "{% $busName %}",
                                        "Detail": "{% $string({ \"ruc\": $inputData.ruc, \"amount\": $inputData.amount, \"orderId\": $inputData.orderId }) %}"
                                    }
                                ]
                            },
                            "End": true
                        }
                    }
                }
            ],
            "End": true
        },
        "SAGA: Reportar Fallo (RUC)": {
            "Type": "Pass",
            "Assign": {
                "failError": "INVALID_RUC",
                "failCause": "RUC Invalido o Error de Validacion"
            },
            "Next": "SAGA: Notificar Fallo"
        },
        "SAGA: Reportar Fallo (Fraude)": {
            "Type": "Pass",
            "Assign": {
                "failError": "HIGH_RISK",
                "failCause": "Transaccion rechazada por sistema de seguridad"
            },
            "Next": "SAGA: Notificar Fallo"
        },
        "SAGA: Reportar Fallo (Banco)": {
            "Type": "Pass",
            "Assign": {
                "failError": "PAGO_RECHAZADO",
                "failCause": "Tarjeta rechazada por la pasarela"
            },
            "Next": "SAGA: Notificar Fallo"
        },
        "SAGA: Reportar Fallo (Tecnico)": {
            "Type": "Pass",
            "Assign": {
                "failError": "SYSTEM_ERROR",
                "failCause": "Error interno del sistema de pagos"
            },
            "Next": "SAGA: Notificar Fallo"
        },
        "SAGA: Notificar Fallo": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:sfn:sendTaskFailure",
            "Comment": "AVISA A ORDER-MS QUE EL PAGO FALLO. ESTO INICIA EL ROLLBACK DE INVENTARIO.",
            "Arguments": {
                "TaskToken": "{% $tokenOrquestador %}",
                "Error": "{% $failError %}",
                "Cause": "{% $failCause %}"
            },
            "Next": "Notificar Usuario: Error"
        },
        "Notificar Usuario: Error": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents",
            "Arguments": {
                "Entries": [
                    {
                        "Source": "app.payments",
                        "DetailType": "Payment.Failed",
                        "EventBusName": "{% $busName %}",
                        "Detail": "{% $string({ \"meta\": $merge([$meta, { \"scope\": \"NOTIFICATION\", \"targetType\": \"USER\", \"targetId\": $meta.userId }]), \"ui\": { \"action\": \"SHOW_TOAST\", \"variant\": \"ERROR\", \"message\": \"Pago rechazado: \" & $failCause }, \"data\": { \"reason\": $failError } }) %}"
                    }
                ]
            },
            "End": true
        },
        "Procesar Reembolso": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:getItem",
            "Arguments": {
                "TableName": "{% $txTable %}",
                "IndexName": "OrderIdIndex",
                "Key": {
                    "orderId": {
                        "S": "{% $inputData.orderId %}"
                    }
                }
            },
            "Assign": {
                "txItem": "{% $states.result.Item %}"
            },
            "Next": "Verificar Transaccion Existe"
        },
        "Verificar Transaccion Existe": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% $exists($txItem) %}",
                    "Next": "Ejecutar Devolucion (Gateway)"
                }
            ],
            "Default": "No Hay Nada Que Reembolsar"
        },
        "No Hay Nada Que Reembolsar": {
            "Type": "Pass",
            "End": true
        },
        "Ejecutar Devolucion (Gateway)": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Comment": "Usa el monto original de la TX si no se especifica uno parcial",
            "Arguments": {
                "FunctionName": "${ProcessRefundFunctionArn}",
                "Payload": {
                    "transactionId": "{% $txItem.gatewayId.S %}",
                    "amount": "{% $inputData.refundAmount ? $inputData.refundAmount : $number($txItem.amount.N) %}"
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "MaxAttempts": 2
                }
            ],
            "Next": "Actualizar DB: Reembolsado"
        },
        "Actualizar DB: Reembolsado": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Arguments": {
                "TableName": "{% $txTable %}",
                "Key": {
                    "pk": {
                        "S": "{% $txItem.pk.S %}"
                    },
                    "sk": {
                        "S": "METADATA"
                    }
                },
                "UpdateExpression": "SET #status = :s, refundDate = :d",
                "ExpressionAttributeNames": {
                    "#status": "status"
                },
                "ExpressionAttributeValues": {
                    ":s": {
                        "S": "REFUNDED"
                    },
                    ":d": {
                        "S": "{% $now() %}"
                    }
                }
            },
            "Next": "Notificar: Reembolso Completado"
        },
        "Notificar: Reembolso Completado": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents",
            "Arguments": {
                "Entries": [
                    {
                        "Source": "app.payments",
                        "DetailType": "Payment.Refunded",
                        "EventBusName": "{% $busName %}",
                        "Detail": "{% $string({ \"meta\": $merge([$meta, { \"scope\": \"NOTIFICATION\", \"targetType\": \"USER\", \"targetId\": $txItem.userId.S }]), \"ui\": { \"action\": \"SHOW_TOAST\", \"variant\": \"INFO\", \"message\": \"Reembolso procesado exitosamente\" }, \"data\": { \"orderId\": $inputData.orderId } }) %}"
                    }
                ]
            },
            "End": true
        }
    }
}