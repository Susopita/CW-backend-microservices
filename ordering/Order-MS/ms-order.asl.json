{
    "Comment": "A description of my state machine",
    "StartAt": "Preparar Contexto",
    "States": {
        "Preparar Contexto": {
            "Type": "Pass",
            "Assign": {
                "inputData": "{% $states.input.detail.data %}",
                "meta": "{% $states.input.detail.meta %}",
                "userId": "{% $states.input.detail.meta.userId %}",
                "eventType": "{% $states.input.'detail-type' %}",
                "tableName": "${self:custom.PedidosTableName}",
                "usersTable": "${self:custom.UsersTableName}",
                "busName": "${self:custom.EventBusName}"
            },
            "Next": "Router Eventos"
        },
        "Router Eventos": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% $eventType = 'Carrito.AgregarItem' %}",
                    "Next": "Carrito: Upsert Item"
                },
                {
                    "Condition": "{% $eventType = 'Carrito.EliminarItem' %}",
                    "Next": "Carrito: Eliminar Item"
                },
                {
                    "Condition": "{% $eventType = 'Carrito.Vaciar' %}",
                    "Next": "Carrito: Vaciar Completo"
                },
                {
                    "Condition": "{% $eventType = 'Pedido.Checkout' %}",
                    "Next": "Checkout: Obtener Carrito"
                },
                {
                    "Condition": "{% $eventType = 'Pedido.Historial' %}",
                    "Next": "Historial: Query Paginada"
                },
                {
                    "Condition": "{% $eventType = 'Pedido.Cancelar' %}",
                    "Next": "Cancelar: Obtener Estado"
                }
            ]
        },
        "Carrito: Upsert Item": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Comment": "Agrega item al carrito y renueva el TTL por 24 horas",
            "Arguments": {
                "TableName": "${self:custom.UsersTableName}",
                "Key": {
                    "user_id": {
                        "S": "{% 'USER#' & $userId %}"
                    },
                    "entity": {
                        "S": "CART"
                    }
                },
                "UpdateExpression": "SET items.#id = :attrs, updatedAt = :now, expiracion = :ttl",
                "ExpressionAttributeNames": {
                    "#id": "{% $inputData.product.sku %}"
                },
                "ExpressionAttributeValues": {
                    ":attrs": {
                        "M": {
                            "nombre": {
                                "S": "{% $inputData.product.name %}"
                            },
                            "precio": {
                                "N": "{% $string($inputData.product.price) %}"
                            },
                            "cantidad": {
                                "N": "{% $string($inputData.product.qty) %}"
                            },
                            "img": {
                                "S": "{% $inputData.product.img ? $inputData.product.img : '' %}"
                            },
                            "opciones": {
                                "S": "{% $inputData.product.options ? $join($inputData.product.options, ', ') : 'Standard' %}"
                            }
                        }
                    },
                    ":now": {
                        "S": "{% $now() %}"
                    },
                    ":ttl": {
                        "N": "{% $string($floor(($millis() + 86400000) / 1000)) %}"
                    }
                }
            },
            "End": true
        },
        "Carrito: Eliminar Item": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Comment": "Elimina una llave específica del mapa de items",
            "Arguments": {
                "TableName": "{% $usersTable %}",
                "Key": {
                    "user_id": {
                        "S": "{% 'USER#' & $userId %}"
                    },
                    "entity": {
                        "S": "CART"
                    }
                },
                "UpdateExpression": "REMOVE items.#sku SET updatedAt = :now",
                "ExpressionAttributeNames": {
                    "#sku": "{% $inputData.skuToRemove %}"
                },
                "ExpressionAttributeValues": {
                    ":now": {
                        "S": "{% $now() %}"
                    }
                }
            },
            "End": true
        },
        "Carrito: Vaciar Completo": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:deleteItem",
            "Arguments": {
                "TableName": "{% $usersTable %}",
                "Key": {
                    "user_id": {
                        "S": "{% 'USER#' & $userId %}"
                    },
                    "entity": {
                        "S": "CART"
                    }
                }
            },
            "End": true
        },
        "Cancelar: Obtener Estado": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:getItem",
            "Arguments": {
                "TableName": "{% $tableName %}",
                "Key": {
                    "pedido_id": {
                        "S": "{% $inputData.orderId %}"
                    },
                    "entity": {
                        "S": "METADATA"
                    }
                }
            },
            "Assign": {
                "orderItem": "{% $states.result.Item %}"
            },
            "Next": "Cancelar: Validar Estado"
        },
        "Cancelar: Validar Estado": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% $orderItem.status.S in ['EN PREPARACION', 'EN DESPACHO', 'PAID'] %}",
                    "Next": "Cancelar: Actualizar DB"
                }
            ],
            "Default": "Notificar: No Cancelable"
        },
        "Notificar: No Cancelable": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents",
            "Comment": "Este evento avisa a Inventario (Devolver Stock) y Pagos (Reembolsar)",
            "Arguments": {
                "Entries": [
                    {
                        "Source": "app.orders",
                        "DetailType": "Pedido.Cancelado",
                        "EventBusName": "{% $busName %}",
                        "Detail": "{% $string({ \"meta\": $merge([\n    $meta,{\n      \"scope\": \"NOTIFICATION\",\n      \"targetType\": \"USER\",\n      \"targetId\": $meta.userId\n    }]),\n  \"ui\": {\n    \"action\": \"SHOW_TOAST\",\n    \"variant\": \"ERROR\",\n    \"message\": \"Pedido no cancelable\"\n  }, \"data\": { \"orderId\": $inputData.orderId, \"reason\": \"UserRequest\", \"refundAmount\": $orderItem.total.N } }) %}"
                    }
                ]
            },
            "End": true
        },
        "Cancelar: Actualizar DB": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Arguments": {
                "TableName": "{% $tableName %}",
                "Key": {
                    "pedido_id": {
                        "S": "{% $inputData.orderId %}"
                    },
                    "entity": {
                        "S": "METADATA"
                    }
                },
                "UpdateExpression": "SET #s = :newStatus, updatedAt = :now",
                "ExpressionAttributeNames": {
                    "#s": "status"
                },
                "ExpressionAttributeValues": {
                    ":newStatus": {
                        "S": "CANCELLED"
                    },
                    ":now": {
                        "S": "{% $now() %}"
                    }
                }
            },
            "Next": "Cancelar: Emitir Evento Compensacion"
        },
        "Cancelar: Emitir Evento Compensacion": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents",
            "Comment": "Este evento avisa a Inventario (Devolver Stock) y Pagos (Reembolsar)",
            "Arguments": {
                "Entries": [
                    {
                        "Source": "app.orders",
                        "DetailType": "Pedido.Cancelado",
                        "EventBusName": "{% $busName %}",
                        "Detail": "{% $string({ \"meta\": $meta, \"data\": { \"orderId\": $inputData.orderId, \"reason\": \"UserRequest\", \"refundAmount\": $orderItem.total.N } }) %}"
                    }
                ]
            },
            "End": true
        },
        "Checkout: Obtener Carrito": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:getItem",
            "Arguments": {
                "TableName": "{% $usersTable %}",
                "Key": {
                    "user_id": {
                        "S": "{% 'USER#' & $userId %}"
                    },
                    "entity": {
                        "S": "CART"
                    }
                }
            },
            "Assign": {
                "cart": "{% $states.result.Item %}",
                "orderId": "{% 'ORD-' & $uuid() %}"
            },
            "Next": "Checkout: Validar"
        },
        "Checkout: Validar": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% $not($exists($cart)) or $not($exists($cart.items.M)) %}",
                    "Next": "Error: Carrito Vacio"
                }
            ],
            "Default": "Checkout: Crear Pedido PENDING"
        },
        "Checkout: Crear Pedido PENDING": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
                "TableName": "{% $tableName %}",
                "Item": {
                    "pedido_id": {
                        "S": "{% $orderId %}"
                    },
                    "entity": {
                        "S": "METADATA"
                    },
                    "user_id": {
                        "S": "{% 'USER#' & $userId %}"
                    },
                    "createdAt": {
                        "S": "{% $now() %}"
                    },
                    "status": {
                        "S": "PENDING"
                    },
                    "items": "{% $cart.items %}",
                    "total": {
                        "N": "100.00"
                    }
                }
            },
            "Next": "SAGA: Reservar Inventario"
        },
        "SAGA: Reservar Inventario": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
            "TimeoutSeconds": 60,
            "Arguments": {
                "Entries": [
                    {
                        "Source": "app.orders",
                        "DetailType": "Stock.Verificar",
                        "EventBusName": "{% $busName %}",
                        "Detail": "{% $string({ \n  \"meta\": $meta, \n  \"data\": { \n    \"orderId\": $orderId, \n    \"items\": $cart.items.M ~> $each(function($v, $k) { { \n    \"productSku\": $k, \n    \"qty\": $v.M.qty.N, \n    \"tenantId\": $inputData.sucursal } } ), \n    \"myTaskToken\": $states.context.Task.Token \n  } } ) %}"
                    }
                ]
            },
            "Next": "SAGA: Procesar Pago",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.Timeout",
                        "SIN_STOCK"
                    ],
                    "Next": "SAGA: Fallo Inventario"
                }
            ]
        },
        "SAGA: Procesar Pago": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
            "TimeoutSeconds": 60,
            "Arguments": {
                "Entries": [
                    {
                        "Source": "app.orders",
                        "DetailType": "Payment.Initiate",
                        "EventBusName": "{% $busName %}",
                        "Detail": "{% $string({ \"meta\": $meta, \"data\": { \"orderId\": $orderId, \"amount\": 100.00, \"paymentToken\": $inputData.paymentToken, \"myTaskToken\": $states.context.Task.Token } }) %}"
                    }
                ]
            },
            "Next": "Checkout: Confirmar y Limpiar",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.Timeout",
                        "PAGO_RECHAZADO"
                    ],
                    "Next": "SAGA: Fallo Pago (Rollback Stock)"
                }
            ]
        },
        "Checkout: Confirmar y Limpiar": {
            "Type": "Parallel",
            "End": true,
            "Branches": [
                {
                    "StartAt": "DB: Marcar Pagado",
                    "States": {
                        "DB: Marcar Pagado": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::dynamodb:updateItem",
                            "Arguments": {
                                "TableName": "{% $tableName %}",
                                "Key": {
                                    "pedido_id": {
                                        "S": "{% $orderId %}"
                                    },
                                    "entity": {
                                        "S": "METADATA"
                                    }
                                },
                                "UpdateExpression": "SET #s = :s",
                                "ExpressionAttributeNames": {
                                    "#s": "status"
                                },
                                "ExpressionAttributeValues": {
                                    ":s": {
                                        "S": "PAID"
                                    }
                                }
                            },
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "DB: Borrar Carrito",
                    "States": {
                        "DB: Borrar Carrito": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::dynamodb:deleteItem",
                            "Arguments": {
                                "TableName": "{% $usersTable %}",
                                "Key": {
                                    "user_id": {
                                        "S": "{% 'USER#' & $userId %}"
                                    },
                                    "entity": {
                                        "S": "CART"
                                    }
                                }
                            },
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "Notificar: Exito",
                    "States": {
                        "Notificar: Exito": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::events:putEvents",
                            "Arguments": {
                                "Entries": [
                                    {
                                        "Source": "app.orders",
                                        "DetailType": "Pedido.CreadoExito",
                                        "EventBusName": "{% $busName %}",
                                        "Detail": "{% $string({ \"meta\": $merge([\n              $meta,{\n                \"scope\": \"NOTIFICATION\",\n                \"targetType\": \"USER\",\n                \"targetId\": $meta.userId\n              }]), \"data\": { \"orderId\": $orderId, \"status\": \"CONFIRMED\" } }) %}"
                                    }
                                ]
                            },
                            "End": true
                        }
                    }
                }
            ]
        },
        "SAGA: Fallo Inventario": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Arguments": {
                "TableName": "{% $tableName %}",
                "Key": {
                    "pedido_id": {
                        "S": "{% $orderId %}"
                    },
                    "entity": {
                        "S": "METADATA"
                    }
                },
                "UpdateExpression": "SET #s = :s",
                "ExpressionAttributeNames": {
                    "#s": "status"
                },
                "ExpressionAttributeValues": {
                    ":s": {
                        "S": "FAILED_STOCK"
                    }
                }
            },
            "Next": "Error: Pedido Fallido"
        },
        "SAGA: Fallo Pago (Rollback Stock)": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents",
            "Comment": "Evento que Inventario escuchará para devolver los items",
            "Arguments": {
                "Entries": [
                    {
                        "Source": "app.orders",
                        "DetailType": "Pedido.Cancelado",
                        "EventBusName": "{% $busName %}",
                        "Detail": "{% $string({ \"meta\": $meta, \"data\": { \"orderId\": $orderId, \"reason\": \"PaymentFailed\" } }) %}"
                    }
                ]
            },
            "Next": "DB: Marcar Fallo Pago"
        },
        "DB: Marcar Fallo Pago": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Arguments": {
                "TableName": "{% $tableName %}",
                "Key": {
                    "pedido_id": {
                        "S": "{% $orderId %}"
                    },
                    "entity": {
                        "S": "METADATA"
                    }
                },
                "UpdateExpression": "SET #s = :s",
                "ExpressionAttributeNames": {
                    "#s": "status"
                },
                "ExpressionAttributeValues": {
                    ":s": {
                        "S": "FAILED_PAYMENT"
                    }
                }
            },
            "Next": "Error: Pedido Fallido"
        },
        "Error: Carrito Vacio": {
            "Type": "Fail",
            "Error": "CartEmpty"
        },
        "Error: Pedido Fallido": {
            "Type": "Fail",
            "Error": "OrderFailed"
        },
        "Historial: Query Paginada": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
            "Arguments": {
                "TableName": "{% $tableName %}",
                "KeyConditionExpression": "user_id = :u",
                "ExpressionAttributeValues": {
                    ":u": {
                        "S": "{% 'USER#' & $userId %}"
                    }
                },
                "ScanIndexForward": false,
                "Limit": 10,
                "ExclusiveStartKey": "{% $inputData.nextPageKey ? $inputData.nextPageKey : null %}"
            },
            "Assign": {
                "ordersList": "{% $states.result.Items %}",
                "nextKey": "{% $states.result.LastEvaluatedKey %}"
            },
            "Next": "Historial: Responder a Cliente"
        },
        "Historial: Responder a Cliente": {
            "Type": "Task",
            "Resource": "arn:aws:states:::events:putEvents",
            "Arguments": {
                "Entries": [
                    {
                        "Source": "app.orders",
                        "DetailType": "Pedido.HistorialEntregado",
                        "EventBusName": "{% $busName %}",
                        "Detail": "{% $string({ \"meta\": $merge([$meta, { \"scope\": \"NOTIFICATION\", \"targetType\": \"CONNECTION\", \"targetId\": $meta.connectionId }]), \"data\": { \"orders\": $ordersList, \"nextPageKey\": $nextKey } }) %}"
                    }
                ]
            },
            "End": true
        }
    },
    "QueryLanguage": "JSONata"
}